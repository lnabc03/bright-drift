{
  "name": "bright-drift-claude-code",
  "version": "0.1.0",
  "description": "Workspace drift awareness for Claude Code: detects external/user file changes via a watcher daemon and injects them into the agent context through hooks.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bright-drift-claude-code": "./lib/cli.js"
  },
  "files": [
    "lib"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude-code",
    "claude-code-hooks",
    "ai-agent",
    "workspace",
    "drift-detection"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lnabc03/bright-drift.git",
    "directory": "packages/claude-code"
  },
  "scripts": {
    "build": "node build.mjs",
    "pretest": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "bright-drift-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
