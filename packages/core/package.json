{
  "name": "bright-drift-core",
  "version": "0.1.0",
  "description": "Platform-independent workspace-drift detection engine for AI coding agents.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai-agent",
    "coding-agent",
    "workspace",
    "file-watcher",
    "drift-detection",
    "attribution"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lnabc03/bright-drift.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "diff": "^9.0.0",
    "ignore": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vitest": "^2.1.0"
  }
}
